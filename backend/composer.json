{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "caseward/backend",
    "type": "project",
    "description": "Caseward backend.",
    "license": "proprietary",
    "require": {
        "php": "~8.5.0",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "ext-pdo_pgsql": "*",
        "ext-redis": "^6.3",
        "laravel/framework": "^13.17"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6.15",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^13.4.3"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "analyse": "phpstan analyse --no-progress --memory-limit=256M",
        "audit:check": "@composer audit --locked",
        "check": [
            "@composer validate --strict",
            "@composer check-platform-reqs",
            "@format:check",
            "@analyse",
            "@test"
        ],
        "format": "pint",
        "format:check": "pint --test",
        "test": "phpunit",
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
