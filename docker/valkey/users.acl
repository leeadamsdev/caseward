user default off
user caseward on >caseward_local db=0 ~caseward:* +ping +select +get +mget +set +setex +exists +del +incrby +expire +ttl +hget +hmset +hincrby +eval +evalsha +rpush +lpop +llen +lrange +lindex +zadd +zcard +zrange +zrangebyscore +zrem +zremrangebyrank
user caseward_testing on >caseward_testing_local db=1 ~caseward_testing:* +ping +select +get +mget +set +setex +exists +del +incrby +expire +ttl +hget +hmset +hincrby +eval +evalsha +rpush +lpop +llen +lrange +lindex +zadd +zcard +zrange +zrangebyscore +zrem +zremrangebyrank +acl|dryrun
