{
    "name": "@caseward/frontend",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@12.14.0",
    "engines": {
        "node": "^24.22.0",
        "pnpm": "^12.14.0"
    },
    "scripts": {
        "dev": "react-router dev",
        "build": "react-router build",
        "check": "pnpm run check:static && pnpm run test:browser",
        "check:static": "pnpm run format:check && pnpm run typecheck && pnpm run lint && pnpm run check:unused && pnpm run test:fast",
        "check:unused": "knip",
        "format": "prettier . --write",
        "format:check": "prettier . --check",
        "lint": "eslint . --max-warnings 0",
        "test": "pnpm run test:fast && pnpm run test:browser",
        "test:browser": "playwright test",
        "test:e2e": "node tests/e2e/run.ts",
        "test:fast": "vitest run",
        "test:unit": "vitest run --project unit",
        "test:integration": "vitest run --project integration",
        "typecheck": "react-router typegen && tsc --noEmit"
    },
    "dependencies": {
        "@base-ui/react": "^1.9.0",
        "@fontsource-variable/inter": "^5.3.0",
        "@react-router/node": "^8.4.0",
        "clsx": "^2.1.1",
        "isbot": "^5.2.2",
        "lucide-react": "^1.58.0",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-router": "^8.4.0",
        "tailwind-merge": "^3.7.0"
    },
    "devDependencies": {
        "@axe-core/playwright": "^4.14.0",
        "@eslint/js": "^10.0.1",
        "@playwright/test": "1.64.1",
        "@react-router/dev": "^8.4.0",
        "@tailwindcss/vite": "^4.3.3",
        "@testing-library/dom": "^10.4.2",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.8",
        "@types/node": "^24.0.0",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "eslint": "^10.12.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-react-hooks": "^7.1.1",
        "jsdom": "^30.1.3",
        "knip": "^6.41.0",
        "msw": "^2.15.0",
        "prettier": "^3.9.10",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "tailwindcss": "^4.3.3",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.71.2",
        "vite": "^8.3.4",
        "vitest": "^5.0.5"
    }
}
